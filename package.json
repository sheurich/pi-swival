{
  "name": "pi-swival",
  "version": "1.0.0",
  "description": "Swival integration for Pi — reviewer loops, sandboxed execution, and isolated native audits",
  "keywords": [
    "pi-package",
    "pi-extension",
    "swival",
    "subagent",
    "sandbox",
    "security-audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheurich/pi-swival.git"
  },
  "homepage": "https://github.com/sheurich/pi-swival#readme",
  "bugs": {
    "url": "https://github.com/sheurich/pi-swival/issues"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "scripts": {
    "test": "cd tests && ./node_modules/.bin/vitest run",
    "test:watch": "cd tests && ./node_modules/.bin/vitest",
    "typecheck": "cd tests && ./node_modules/.bin/tsc -p tsconfig.json",
    "smoke": "./scripts/smoke-test.sh",
    "agentfs-integration": "./scripts/agentfs-integration-test.sh",
    "ci": "npm run typecheck && npm run smoke && npm run agentfs-integration && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
