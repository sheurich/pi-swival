{
  "name": "pi-swival",
  "version": "1.0.0",
  "description": "Swival integration for Pi — reviewer loops, sandboxed execution, and multi-bucket security audits",
  "keywords": [
    "pi-package",
    "pi-extension",
    "swival",
    "subagent",
    "sandbox",
    "security-audit"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sheurich/pi-swival.git"
  },
  "homepage": "https://github.com/sheurich/pi-swival#readme",
  "bugs": {
    "url": "https://github.com/sheurich/pi-swival/issues"
  },
  "pi": {
    "extensions": ["./extensions"],
    "skills": ["./skills"],
    "prompts": ["./prompts"]
  },
  "scripts": {
    "test": "cd tests && ./setup.sh && npx vitest run",
    "test:watch": "cd tests && ./setup.sh && npx vitest",
    "smoke": "./scripts/smoke-test.sh",
    "ci": "npm run smoke && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
