# pi-swival unknown-agent recovery demo
#
# Render through `make -C demo quick`. demo/record.sh supplies a disposable
# HOME, a clean checkout, selected provider credentials, and the
# pi-swival extension as the only loaded resource.

Output demo/demo-quick.gif
Output demo/demo-quick.mp4

Set Shell bash
Set FontSize 14
Set Width 1280
Set Height 760
Set Theme "Dracula"
Set TypingSpeed 25ms
Set WindowBar Colorful
Set Padding 16
Set Margin 16
Set MarginFill "#0a0a14"
Set WaitTimeout 90s

# Enter the disposable workspace without recording its generated path.
Hide
Type `mkdir -p "$PI_SWIVAL_DEMO_REPO/workspace" && cd "$PI_SWIVAL_DEMO_REPO/workspace" && clear`
Enter
Sleep 500ms
Show

Type "# pi-swival: unknown agent errors now include the discovered roster"
Enter
Sleep 1500ms
Type "printf 'Pi '; pi --version"
Enter
Sleep 2s

# The launcher is generated by record.sh and starts Pi with ambient resources
# disabled. Its short command keeps provider credentials and local paths out of
# the recording.
Type "pi-swival-demo quick"
Enter
Sleep 4s

Type@35ms `Call swival-subagent once with agent "review-worker", agentScope "user", and task "Demo unknown-agent recovery." Do not call any other tool.`
Sleep 750ms
Enter
Wait+Screen /Roster received\./
Sleep 4s
Type "/quit"
Enter
Sleep 2s
