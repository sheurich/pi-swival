{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@earendil-works/*": ["./node_modules/@earendil-works/*"],
      "typebox": ["./node_modules/typebox"]
    }
  },
  "include": ["../extensions/**/*.ts"]
}
